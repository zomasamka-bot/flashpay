{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": ".r36-build",
    "rootDir": "lib",
    "noEmitOnError": true
  },
  "include": [
    "lib/r36-operator-cli.ts",
    "lib/r36-production-operator.ts",
    "lib/r36-registration-operator.ts",
    "lib/r36-inbound-evidence-cli.ts",
    "lib/r36-certificate-registrar.ts",
    "lib/r36-wallet-lifecycle.ts",
    "lib/r36-wallet-lifecycle-cli.ts",
    "lib/r36-live-source.ts",
    "lib/r36-live-evidence-producer.ts",
    "lib/r36-live-evidence-cli.ts",
    "lib/r36-evidence-publication-cli.ts",
    "lib/r36-evidence-dispatcher.ts",
    "lib/r36-provider-read-proxy.ts",
    "lib/r36-prepared-evidence.ts",
    "lib/r36-terminal-evidence-producer.ts",
    "lib/r36-lifecycle-publication.ts",
    "lib/r36-automatic-lifecycle.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
